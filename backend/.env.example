# Direct backend PostgreSQL development template.
# Copy to backend/.env and replace placeholder credentials locally.
# Optional server-side Google Routes key. Enable Routes API and set Cloud quotas before public use.
GOOGLE_ROUTES_API_KEY=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=nearpill_app
DB_PASSWORD=replace-with-a-local-password
DB_NAME=nearpill
DB_SSL=false
PORT=3001
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
PUBLIC_APP_URL=http://localhost:3001
# Development compatibility value only; staging/production must set an owner-approved policy.
ORDER_RESERVATION_TTL_MINUTES=4320

# Optional Brevo mail settings. Configure both together when enabling mail.
BREVO_API_KEY=
MAIL_FROM=

# Online payment collection remains disabled until a provider and policy are owner-approved.
PAYMENT_POLICY_MODE=disabled
PAYMENT_POLICY_VERSION=unconfigured
# XENDIT_TEST_SECRET_KEY=
# XENDIT_TEST_WEBHOOK_TOKEN=
# PAYMENT_DEPOSIT_BASIS_POINTS=
PAYMENT_REFUNDS_ENABLED=false

# Optional: exact verified ingress socket IP(s) only; never use subnets or wildcards.
# Keep unset until NGINX / staging proxy peers are confirmed by real network tests.
# TRUSTED_PROXY_IPS=

# Ask NearPill chat assistant (free key from https://aistudio.google.com/apikey). Leave blank to turn the assistant off.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Deployed API only: Supabase signs its database certificate with its own CA. Copy the public
# certificate to backend/certs/supabase-ca-2021.crt; the deploy image sets this automatically.
# Local development: point it at your own copy of the certificate file.
# NODE_EXTRA_CA_CERTS=
