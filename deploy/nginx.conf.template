worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log /dev/stdout;
  sendfile on;
  server_tokens off;

  # Only Render's load balancer can reach this container, and it puts the real client
  # address last in X-Forwarded-For. The API trusts this nginx (TRUSTED_PROXY_IPS=127.0.0.1).
  set_real_ip_from 0.0.0.0/0;
  real_ip_header X-Forwarded-For;
  real_ip_recursive off;

  map $http_x_forwarded_proto $nearpill_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
  }

  map "$status:$uri" $nearpill_cache_control {
    ~^(200|206|304):/assets/ "public, max-age=31536000, immutable";
    ~^(200):/(robots\.txt|sitemap\.xml)$ "public, max-age=3600";
    default "no-store";
  }

  # Client-side routes that answer 200 with the app shell. Everything else under
  # location / is a genuine 404 (still rendered by the SPA's "Page not found" screen).
  # Keep in sync with SITE_PATHS and PORTAL_PATHS in web/src/app/App.tsx.
  map $uri $nearpill_known_route {
    default 0;
    ~^/$ 1;
    ~^/(features|partners|about|contact|policies)/?$ 1;
    ~^/site(/|$) 1;
    ~^/(portal|dashboard|pharmacies|orders|catalog|subscriptions|reports|staff|stock-submissions|partner)(/|$) 1;
  }

  server {
    listen ${PUBLIC_PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 2m;

    location /api/ {
      proxy_pass http://127.0.0.1:3001;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $nearpill_proto;
      proxy_read_timeout 60s;
    }

    location = /reset-password {
      proxy_pass http://127.0.0.1:3001;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Proto $nearpill_proto;
    }

    location /recovery/ {
      proxy_pass http://127.0.0.1:3001;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Proto $nearpill_proto;
    }

    location /assets/ {
      include /etc/nginx/snippets/nginx-headers-portal.conf;
      try_files $uri =404;
    }

    # The customer app shows a map and reads the visitor's location, so it gets its own headers.
    # try_files falling back to /index.html would re-enter location / and lose these headers
    # (and the Google Maps / geolocation allowances), so the fallback is a named location.
    location ~ ^/app(/|$) {
      include /etc/nginx/snippets/nginx-headers-app.conf;
      try_files $uri @app_index;
    }

    location @app_index {
      include /etc/nginx/snippets/nginx-headers-app.conf;
      rewrite ^ /index.html break;
    }

    location / {
      include /etc/nginx/snippets/nginx-headers-portal.conf;
      try_files $uri $uri/ @site;
    }

    # Known site and portal routes get the SPA shell with 200. Any other path gets the same
    # shell (so React renders "Page not found") but with a real 404 status.
    # A try_files fallback to /index.html would re-enter location /, hence the named location.
    location @site {
      include /etc/nginx/snippets/nginx-headers-portal.conf;
      error_page 404 =404 /index.html;
      if ($nearpill_known_route = 0) { return 404; }
      rewrite ^ /index.html break;
    }
  }
}
