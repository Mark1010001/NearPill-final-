{
  "name": "nearpill",
  "private": true,
  "version": "0.1.0",
  "description": "NearPill root engineering orchestration",
  "engines": {
    "node": ">=24.7.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "start:backend": "npm --prefix backend start",
    "dev:backend": "npm --prefix backend run dev",
    "verify:packet0": "bash scripts/verify-packet0.sh",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:syntax": "node scripts/check-js-syntax.mjs",
    "check:shell-syntax": "bash scripts/check-shell-syntax.sh",
    "check:json-syntax": "node scripts/check-json-syntax.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:web",
    "lint": "eslint eslint.config.mjs scripts/*.mjs test/engineering-foundation.test.mjs",
    "format:check": "prettier --check package.json tsconfig.json tsconfig.base.json eslint.config.mjs .prettierrc.json compose.yaml scripts test/engineering-foundation.test.mjs backend/src/config/env.ts backend/src/bootstrap/server.ts backend/src/http/**/*.ts .github/workflows/ci.yml",
    "test:foundation": "node --test test/engineering-foundation.test.mjs",
    "test:config": "node --test test/env-config.test.mjs",
    "test:backend": "node --test backend/test/*.test.mjs test/web_service_information.test.cjs",
    "test": "npm run test:foundation && npm run test:config && npm run test:backend",
    "secret:scan": "node scripts/secret-scan.mjs",
    "package:source": "bash scripts/package-source.sh",
    "verify:foundation": "bash scripts/verify-foundation.sh",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "install:clean": "npm ci --ignore-scripts && npm ci --prefix backend",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:reconcile": "npm --prefix backend run db:reconcile",
    "test:postgres-contract": "node --test backend/test/postgres-migration-contract.test.mjs",
    "db:verify-security": "npm --prefix backend run db:verify-security",
    "test:identity-security": "node --test backend/test/identity-security.test.mjs",
    "db:verify-identity": "npm --prefix backend run db:verify-identity",
    "test:http-contract": "node --test backend/test/http-transport-contract.test.mjs",
    "check:backend-lockfile": "node scripts/check-backend-lockfile.mjs",
    "db:verify-order-inventory": "npm --prefix backend run db:verify-order-inventory",
    "test:payments": "npm --prefix backend run test:payments",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "typecheck:web": "npm --prefix web run typecheck",
    "test:web:e2e": "npm --prefix web run test:e2e",
    "test:portal": "node --test test/portal-migration.test.mjs",
    "verify:mobile": "bash scripts/verify-mobile.sh"
  },
  "devDependencies": {
    "eslint": "10.10.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "@types/node": "24.19.2"
  },
  "packageManager": "npm@11.19.1"
}
