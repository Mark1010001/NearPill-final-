# NearPill local PostgreSQL development template.
# Copy to .env for Docker Compose. Never commit populated .env files.

DB_NAME=nearpill
DB_USER=nearpill_app
DB_PASSWORD=replace-with-a-local-app-password
MIGRATOR_DB_USER=nearpill_migrator
MIGRATOR_DB_PASSWORD=replace-with-a-local-migrator-password
# Approved Supabase staging verification only: set a separate direct TLS migrator
# endpoint through protected environment settings, never a pooler.
# MIGRATOR_DB_HOST=db.<approved-project-ref>.supabase.co
# MIGRATOR_DB_PORT=5432
# NEARPILL_VERIFICATION_EXPECTED_MIGRATOR_HOST=db.<approved-project-ref>.supabase.co
POSTGRES_OWNER_USER=nearpill_owner
POSTGRES_OWNER_PASSWORD=replace-with-a-local-owner-password

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
PUBLIC_APP_URL=http://localhost:8080
# Development compatibility value only; staging/production must set an owner-approved policy.
ORDER_RESERVATION_TTL_MINUTES=4320

# Optional local mail settings. Configure both together when enabling mail.
# BREVO_API_KEY=
# MAIL_FROM=NearPill <noreply@example.test>

# Online payment collection remains disabled until a provider and policy are owner-approved.
PAYMENT_POLICY_MODE=disabled
PAYMENT_POLICY_VERSION=unconfigured
# Required only for deposit_or_full mode. 5000 = 50%, but do not set without owner approval.
# PAYMENT_DEPOSIT_BASIS_POINTS=
PAYMENT_REFUNDS_ENABLED=false

# Optional: exact verified ingress socket IP(s) only; never use subnets or wildcards.
# Keep unset until NGINX / staging proxy peers are confirmed by real network tests.
# TRUSTED_PROXY_IPS=

# Optional: Google Maps key for the customer WEBSITE map only (browser key, HTTP-referrer restricted, Maps JavaScript API only).
# Never reuse the server Routes key or the Android key here. Leave empty to use the OpenStreetMap fallback map.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Local only: set DEV_ECHO_OTP=true to have the API return the code instead of emailing it. Never set in staging/production.
# DEV_ECHO_OTP=true


# Ask NearPill chat assistant (free key from https://aistudio.google.com/apikey). Leave blank to turn the assistant off.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
